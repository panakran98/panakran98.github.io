        },
        body: JSON.stringify([
          payload
        ])
      }).catch((error2) => console.error("Failed to report JET error", error2));
    } catch {
    }
  }
  function reportMetric(groupName, metricName) {
    try {
      fetch("/sensorCollect/?action=reportMetrics", {
        method: "POST",
        credentials: "include",
        headers: {
          "content-type": "application/json",
          "csrf-token": csrfToken,
