          theme: d.body?.getAttribute("data-color-scheme") === "dark" ? "DARK" : "LIGHT"
        }
      }
    };
    try {
      fetch(ep, {
        method: "POST",
        mode: "cors",
        credentials: "include",
        headers: {
          "content-type": "application/json",
